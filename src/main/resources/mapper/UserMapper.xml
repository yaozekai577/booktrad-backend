<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.booktrad.user.mapper.UserMapper">

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultType="com.booktrad.user.entity.User">
        SELECT * FROM user WHERE username = #{username} AND deleted_at IS NULL
    </select>

    <!-- 查询所有用户 -->
    <select id="selectAllUsers" resultType="com.booktrad.user.entity.User">
        SELECT * FROM user
    </select>

    <!-- 动态条件查询用户 -->
    <select id="selectUsersByCondition" resultType="com.booktrad.user.entity.User">
        SELECT * FROM user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="role != null">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            AND deleted_at IS NULL
        </where>
        ORDER BY created_at DESC
    </select>
</mapper>